OPENCOST_URL=http://opencost.opencost.svc.cluster.local:9003
VM_URL=http://vmsingle-vmks-victoria-metrics-k8s-stack.vmks.svc.cluster.local:8428
YC_BUCKET=finops-billing
YC_REGION=ru-central1
YC_ENDPOINT=https://storage.yandexcloud.net
YC_ACCESS_KEY=your-access-key
YC_SECRET_KEY=your-secret-key

# Application
ENV=development
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql+asyncpg://finops:finops@localhost:5432/finops
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=300

# Crypto — generate via: python scripts/generate_fernet_key.py
FERNET_KEY=

# Scheduler
SCHEDULER_ENABLED=true
BILLING_SYNC_INTERVAL_MINUTES=60
METRICS_SNAPSHOT_INTERVAL_MINUTES=15