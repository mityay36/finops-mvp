# DO NOT COMMIT REAL SECRET. Create manually:
#
# kubectl create secret generic finops-api-secrets -n finops \
#   --from-literal=DATABASE_URL='postgresql+asyncpg://finops:PG_PASS@postgres.finops.svc.cluster.local:5432/finops' \
#   --from-literal=REDIS_URL='redis://:REDIS_PASS@redis.finops.svc.cluster.local:6379/0' \
#   --from-literal=FERNET_KEY='<output of api/scripts/generate_fernet_key.py>'
apiVersion: v1
kind: Secret
metadata:
  name: finops-api-secrets
  namespace: finops
type: Opaque
stringData:
  DATABASE_URL: "postgresql+asyncpg://finops:CHANGE_ME@postgres.finops.svc.cluster.local:5432/finops"
  REDIS_URL: "redis://:CHANGE_ME@redis.finops.svc.cluster.local:6379/0"
  FERNET_KEY: "CHANGE_ME"