# DO NOT COMMIT REAL SECRET. Create manually:
#
# PG_PASS=$(openssl rand -base64 24 | tr -d '/+=')
# kubectl create secret generic finops-postgres-secret -n finops \
#   --from-literal=POSTGRES_USER=finops \
#   --from-literal=POSTGRES_DB=finops \
#   --from-literal=POSTGRES_PASSWORD="$PG_PASS"
apiVersion: v1
kind: Secret
metadata:
  name: finops-postgres-secret
  namespace: finops
type: Opaque
stringData:
  POSTGRES_USER: finops
  POSTGRES_DB: finops
  POSTGRES_PASSWORD: CHANGE_ME